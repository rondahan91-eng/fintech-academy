{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "FinTech Academy — טוקני עיצוב. אכרומטי עם הדגשה יחידה, מותאם לאפליקציית עבודה בעברית על מסך 1366. הנימוקים ב-DESIGN.md.",

  "ink": {
    "strong": { "$value": "#211d1d", "$type": "color", "$description": "גוף טקסט ארוך בניגודיות גבוהה" },
    "base":   { "$value": "#2c2d30", "$type": "color", "$description": "טקסט ראשי, כותרות, אייקונים" },
    "muted":  { "$value": "#6e6f72", "$type": "color", "$description": "טקסט משני, עזרה, תוויות שדה" },
    "faint":  { "$value": "#97989a", "$type": "color", "$description": "מצב מושבת, placeholder" }
  },

  "line": {
    "base":   { "$value": "#dcdcde", "$type": "color", "$description": "קווי הפרדה ומסגרות — הצבע הנפוץ ביותר במערכת" },
    "strong": { "$value": "#afafaf", "$type": "color", "$description": "גבול מודגש, שדה קלט במיקוד" }
  },

  "surface": {
    "canvas": { "$value": "#f6f6f8", "$type": "color", "$description": "רקע האפליקציה. אפור בקושי נראה — הוא מה שמאפשר לפאנלים הלבנים להיקרא כמשטחים נפרדים" },
    "panel":  { "$value": "#ffffff", "$type": "color", "$description": "פאנלים, כרטיסים, שדות. **פאנל אלעד חייב להיות לבן** — האווטארים שקופים ויקבלו הילה על כל רקע אחר" },
    "sunken": { "$value": "#f0f0f2", "$type": "color", "$description": "עורך הקוד ואזור הפלט — שקוע, לא מוגבה" },
    "hover":  { "$value": "#ececef", "$type": "color", "$description": "ריחוף על פריט אינטראקטיבי" }
  },

  "accent": {
    "base":    { "$value": "#00a382", "$type": "color", "$description": "**פעולה ראשית בלבד.** לא גבולות, לא אייקונים, לא ריחוף, לא טקסט. פעולה אחת דומיננטית למסך" },
    "pressed": { "$value": "#008a6e", "$type": "color", "$description": "לחיצה" },
    "on":      { "$value": "#ffffff", "$type": "color", "$description": "טקסט על גבי ההדגשה" }
  },

  "state": {
    "pass": {
      "wash": { "$value": "#d9f2e9", "$type": "color" },
      "ink":  { "$value": "#16785f", "$type": "color" },
      "$description": "בדיקה עברה. הדיו לאייקון ולמונה, לא לטקסט גוף"
    },
    "pending": {
      "wash": { "$value": "#f4ebe4", "$type": "color" },
      "ink":  { "$value": "#7a6a5e", "$type": "color" },
      "$description": "בדיקה טרם עברה. **נייטרלי חם בכוונה ולא אדום** — תלמיד יריץ 15 פעם לפני שיעבור, וזה המצב הרגיל ולא שגיאה"
    },
    "attention": {
      "wash": { "$value": "#faeddb", "$type": "color" },
      "ink":  { "$value": "#8a6320", "$type": "color" },
      "$description": "דדליין מתקרב, חלון חזרה נסגר, פעולה נדרשת"
    },
    "breach": {
      "wash": { "$value": "#f5e2e0", "$type": "color" },
      "ink":  { "$value": "#9c463b", "$type": "color" },
      "$description": "**הפרה אתית בלבד** — מכירה שפוגעת בלקוח, שירוט, ניסיון חוזר לחלץ פתרון. הצבע היחיד במערכת שמזהיר, ולעולם לא על באג"
    }
  },

  "font": {
    "ui": {
      "$value": "\"Assistant\", \"Heebo\", \"Segoe UI\", \"Arial Hebrew\", Arial, sans-serif",
      "$type": "fontFamily",
      "$description": "כל הממשק. חייב תמיכה מלאה בעברית ובניקוד. **מוגש מקומית** — סביבה סגורה, אין CDN"
    },
    "code": {
      "$value": "Consolas, \"Courier New\", ui-monospace, monospace",
      "$type": "fontFamily",
      "$description": "עורך הקוד, הפלט, ושמות משתנים בתוך טקסט. Consolas קיים בכל מכונת Windows — אפס הורדה, אפס סיכון"
    }
  },

  "typography": {
    "micro":      { "$value": { "fontFamily": "ui", "fontSize": "12px", "fontWeight": 500, "lineHeight": 1.35 }, "$type": "typography", "$description": "תג, צ'יפ, תווית עזר" },
    "caption":    { "$value": { "fontFamily": "ui", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.45 }, "$type": "typography", "$description": "טקסט משני, הערות" },
    "body":       { "$value": { "fontFamily": "ui", "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.55 }, "$type": "typography", "$description": "ברירת המחדל. שורה 1.55 — עברית צריכה יותר אוויר מלטינית" },
    "body-lg":    { "$value": { "fontFamily": "ui", "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.55 }, "$type": "typography", "$description": "טקסט המשימה — נקרא לאורך זמן" },
    "subheading": { "$value": { "fontFamily": "ui", "fontSize": "18px", "fontWeight": 500, "lineHeight": 1.4 },  "$type": "typography" },
    "heading":    { "$value": { "fontFamily": "ui", "fontSize": "21px", "fontWeight": 600, "lineHeight": 1.35 }, "$type": "typography", "$description": "כותרת מסך" },
    "heading-lg": { "$value": { "fontFamily": "ui", "fontSize": "26px", "fontWeight": 600, "lineHeight": 1.3 },  "$type": "typography", "$description": "המדרגה הגדולה ביותר. אין display — אין באפליקציה כותרת ראווה" },
    "code":       { "$value": { "fontFamily": "code", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.6 }, "$type": "typography" }
  },

  "tracking": {
    "base": { "$value": "0", "$type": "dimension", "$description": "אפס לאורך כל הסולם. **עברית לא מרוויחה ממרווח אותיות שלילי** — הוא מדביק אותיות סופיות ופוגע בקריאות" }
  },

  "spacing": {
    "4":  { "$value": "4px",  "$type": "dimension" },
    "8":  { "$value": "8px",  "$type": "dimension" },
    "12": { "$value": "12px", "$type": "dimension" },
    "16": { "$value": "16px", "$type": "dimension" },
    "24": { "$value": "24px", "$type": "dimension" },
    "32": { "$value": "32px", "$type": "dimension" },
    "48": { "$value": "48px", "$type": "dimension" },
    "unit": { "$value": "4px", "$type": "dimension", "$description": "בסיס 4 ולא 8 — סרגלים וצ'יפים באפליקציה צפופה צריכים חצי מדרגה" }
  },

  "radius": {
    "sm":     { "$value": "4px",   "$type": "dimension", "$description": "צ'יפ, תג" },
    "md":     { "$value": "8px",   "$type": "dimension", "$description": "כפתור, שדה, טאב" },
    "lg":     { "$value": "12px",  "$type": "dimension", "$description": "פאנל, כרטיס" },
    "bubble": { "$value": "14px",  "$type": "dimension", "$description": "בועת צ'אט" },
    "pill":   { "$value": "999px", "$type": "dimension", "$description": "**פעולה ראשית בלבד.** גלולה על כל כפתור הופכת סרגל צפוף לרועש" }
  },

  "elevation": {
    "hairline": { "$value": "0 0 0 1px #dcdcde", "$type": "shadow", "$description": "ההגבהה היחידה. אין צללים — הפרדה בקו ובמשטח" }
  },

  "layout": {
    "app-min-width": { "$value": "1280px", "$type": "dimension", "$description": "מתחת לזה עמודת המשימה מתקפלת לטאב. **פאנל אלעד לעולם לא מתקפל**" },
    "panel-elad":    { "$value": "300px",  "$type": "dimension" },
    "panel-task":    { "$value": "290px",  "$type": "dimension" },
    "topbar-height": { "$value": "52px",   "$type": "dimension" },
    "avatar-height": { "$value": "190px",  "$type": "dimension" }
  },

  "motion": {
    "fast": { "$value": "120ms ease-out", "$type": "duration", "$description": "ריחוף, מיקוד" },
    "base": { "$value": "200ms ease-out", "$type": "duration", "$description": "החלפת מצב אווטאר, פתיחת פאנל" }
  }
}
